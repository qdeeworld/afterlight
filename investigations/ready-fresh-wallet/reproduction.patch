+// Afterlight investigation only. Local test contracts and test-supplied proof facts;
+// these tests do not run Ready X, generate an authentic proof, or use Mainnet funds.
+fn afterlight_channel_case(initialized: bool, unrelated_setup: bool) {
+    let mut test: Test = Default::default();
+    let mut user = test.new_user();
+    let token = test.new_token();
+    let token_addr = token.contract_address();
+    let other_token = test.new_token();
+    let other_token_addr = other_token.contract_address();
+    user.set_viewing_key_e2e();
+    user.open_channel_e2e(recipient: user, index: 0);
+    if initialized {
+        user.open_subchannel_e2e(recipient: user, :token_addr, index: 0);
+    }
+
+    let mut client_actions = array![];
+    let has_prefix = !initialized || unrelated_setup;
+    if has_prefix {
+        let setup_token = if unrelated_setup { other_token_addr } else { token_addr };
+        let setup_index = if initialized { 1 } else { 0 };
+        client_actions.append(ClientAction::OpenSubchannel(OpenSubchannelInput {
+            recipient_addr: user.address,
+            recipient_public_key: user.public_key,
+            channel_key: user.compute_channel_key(recipient: user),
+            index: setup_index,
+            token: setup_token,
+            salt: user.get_salt().into(),
+        }));
+    }
+    let random = user.get_random();
+    let note_input = user.new_open_note(recipient: user, :token_addr, index: 0, :random);
+    let amount = 1_u128;
+    let (note_id, expected_note) = user.compute_open_note_with_amount(create_note_input: note_input, :amount);
+    let invoke_input = test.privacy.invoke_external_echo_deposits(
+        [OpenNoteDeposit { note_id, token: token_addr, amount }].span(),
+    );
+    client_actions.append(ClientAction::CreateOpenNote(note_input));
+    client_actions.append(ClientAction::InvokeExternal(invoke_input));
+    let actions = user.compile_actions(client_actions: client_actions.span());
+    let mut actual_types = array![];
+    for action in actions {
+        let mut encoded = array![];
+        action.serialize(ref encoded);
+        actual_types.append(*encoded.at(0));
+    }
+    if has_prefix {
+        assert_eq!(actual_types.span(), [0, 0, 0, 7, 10].span());
+    } else {
+        assert_eq!(actual_types.span(), [0, 7, 10].span());
+    }
+    // Compilation alone did not deposit anything or initialize the missing channel.
+    assert_eq!(test.privacy.get_note(:note_id), Zero::zero());
+    if !initialized {
+        assert!(!test.privacy.subchannel_exists(
+            subchannel_marker: user.compute_subchannel_marker(recipient: user, :token_addr),
+        ));
+    }
+
+    // Use the upstream echo depositor, NOT the Afterlight contract. Its mock funds
+    // and proof-fact cheat are explicitly outside Mainnet/proof verification claims.
+    token.supply(address: test.privacy.echo_executor, :amount);
+    token.approve(owner: test.privacy.echo_executor, spender: test.privacy.address, amount: amount.into());
+    test.privacy.apply_actions(:actions);
+    assert_eq!(test.privacy.get_note(:note_id), expected_note);
+    if unrelated_setup {
+        assert!(test.privacy.subchannel_exists(
+            subchannel_marker: user.compute_subchannel_marker(recipient: user, token_addr: other_token_addr),
+        ));
+    }
+}
+
+#[test]
+fn test_afterlight_fresh_token_channel_five_actions() {
+    afterlight_channel_case(initialized: false, unrelated_setup: false);
+}
+
+#[test]
+fn test_afterlight_separate_setup_three_actions() {
+    afterlight_channel_case(initialized: true, unrelated_setup: false);
+}
+
+#[test]
+fn test_afterlight_unrelated_setup_same_five_actions() {
+    afterlight_channel_case(initialized: true, unrelated_setup: true);
+}
