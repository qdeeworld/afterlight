+++ b/sdk/tests/internal/afterlight-fresh-wallet.test.ts
@@ -0,0 +1,107 @@
+/**
+ * Afterlight compatibility investigation, SDK pin 66e3caae8c0201227a6719696d004e30d90aea65.
+ * LOCAL MOCKNET ONLY. No RPC, wallet extension, funds, fees or authentic proofs.
+ * The MockPool emits client-action labels, not serialized Cairo ServerActions.
+ * cairoExpansion below is an explicit source-derived mapping, not captured output.
+ */
+import { describe, expect, it } from "vitest";
+import { Mocknet } from "../../src/testing/mocknet.js";
+import { Open, type Actions, type ExecuteOptions } from "../../src/interfaces.js";
+import { bigintReviver } from "../../src/testing/mock-proof-invocation-factory.js";
+import type { ClientAction } from "../../src/internal/client-actions.js";
+
+const AUTO_CHANNELS_ONLY: ExecuteOptions = { autoDiscover: { channels: "refresh" }, autoSetup: true };
+
+const cairoExpansion = (actions: ClientAction[]) => actions.flatMap((action) => {
+  switch (action.type) {
+    case "OpenSubchannel": return [0, 0];
+    case "CreateOpenNote": return [0, 7];
+    case "InvokeExternal": return [10];
+    default: throw new Error(`Unmapped client action: ${action.type}`);
+  }
+});
+
+async function registeredSelfChannel() {
+  const mocknet = new Mocknet({ poolAddress: 1n });
+  const env = mocknet.initialize();
+  const transfers = { alice: mocknet.createPrivateTransfers(env.alice.address, env.alice.privateKey) };
+  mocknet.executeOutside(await transfers.alice.build().register().execute());
+  mocknet.executeOutside(await transfers.alice.build().setup(env.alice.address).execute());
+  return { mocknet, env, transfers };
+}
+
+function openNoteAndInvoke(context: Awaited<ReturnType<typeof registeredSelfChannel>>): Actions {
+  return {
+    createNotes: [{ recipient: context.env.alice.address, token: BigInt(context.env.ace), amount: Open }],
+    invoke: { callBuilder: ({ openNotes }) => ({ contractAddress: "0x1234", calldata: [openNotes[0].noteId] }) },
+  };
+}
+
+async function compile(context: Awaited<ReturnType<typeof registeredSelfChannel>>, actions: Actions) {
+  const invocation = await context.transfers.alice.createProofInvocation(actions, AUTO_CHANNELS_ONLY);
+  const plan = JSON.parse((invocation.invocation.calldata as string[])[2], bigintReviver) as ClientAction[];
+  // Exercises upstream MockPool preconditions without applying the returned actions.
+  const result = await context.transfers.alice.executeWithInvocation(invocation);
+  expect(result.callAndProof.proof.data).toBe(""); // Explicitly NOT an authentic proof.
+  return { plan, result };
+}
+
+describe("Afterlight fresh-wallet SDK reproduction — mock/protocol evidence only", () => {
+  it("registered self-channel without this token compiles the five-action candidate", async () => {
+    const context = await registeredSelfChannel();
+    const { plan } = await compile(context, openNoteAndInvoke(context));
+    expect(plan.map((action) => action.type)).toEqual(["OpenSubchannel", "CreateOpenNote", "InvokeExternal"]);
+    expect(cairoExpansion(plan)).toEqual([0, 0, 0, 7, 10]);
+    const setup = plan[0];
+    const note = plan[1];
+    if (setup.type !== "OpenSubchannel" || note.type !== "CreateOpenNote") throw new Error("wrong plan");
+    expect(setup.input.token).toBe(note.input.token);
+    expect(setup.input.recipient_addr).toBe(note.input.recipient_addr);
+    expect((await context.transfers.alice.discoverNotes()).notes.get(BigInt(context.env.ace)) ?? []).toHaveLength(0);
+    // A preparation alone does not initialize the token channel.
+    expect(cairoExpansion((await compile(context, openNoteAndInvoke(context))).plan)).toEqual([0, 0, 0, 7, 10]);
+  });
+
+  it("explicit token setup removes the prefix without requiring a private token balance", async () => {
+    const context = await registeredSelfChannel();
+    const { mocknet, env, transfers } = context;
+    mocknet.executeOutside(await transfers.alice.build(AUTO_CHANNELS_ONLY).with(env.ace).setup(env.alice.address).execute());
+    const { plan } = await compile(context, openNoteAndInvoke(context));
+    expect(plan.map((action) => action.type)).toEqual(["CreateOpenNote", "InvokeExternal"]);
+    expect(cairoExpansion(plan)).toEqual([0, 7, 10]);
+    expect((await transfers.alice.discoverNotes()).notes.get(BigInt(env.ace)) ?? []).toHaveLength(0);
+  });
+
+  it("positive deposit-to-self also initializes the token channel in Mocknet", async () => {
+    const context = await registeredSelfChannel();
+    const { mocknet, env, transfers } = context;
+    mocknet.executeOutside(await transfers.alice.build(AUTO_CHANNELS_ONLY).with(env.ace).deposit({ amount: 1n }).execute());
+    const { plan } = await compile(context, openNoteAndInvoke(context));
+    expect(cairoExpansion(plan)).toEqual([0, 7, 10]);
+    const notes = (await transfers.alice.discoverNotes()).notes.get(BigInt(env.ace)) ?? [];
+    expect(notes.reduce((sum, note) => sum + BigInt(note.amount), 0n)).toBe(1n);
+  });
+
+  it("zero closed self-transfer is rejected, so it is not a free setup workaround", async () => {
+    const context = await registeredSelfChannel();
+    await expect(context.transfers.alice.build(AUTO_CHANNELS_ONLY).with(context.env.ace)
+      .transfer({ recipient: context.env.alice.address, amount: 0n }).execute()).rejects.toThrow();
+  });
+
+  it("unrelated token setup can pass MockPool preconditions with the same expanded shape", async () => {
+    const context = await registeredSelfChannel();
+    const { mocknet, env, transfers } = context;
+    mocknet.executeOutside(await transfers.alice.build(AUTO_CHANNELS_ONLY).with(env.ace).setup(env.alice.address).execute());
+    const { plan } = await compile(context, {
+      ...openNoteAndInvoke(context),
+      openTokenChannels: [{ recipient: env.alice.address, token: BigInt(env.bee) }],
+    });
+    expect(cairoExpansion(plan)).toEqual([0, 0, 0, 7, 10]);
+    const setup = plan[0];
+    const note = plan[1];
+    if (setup.type !== "OpenSubchannel" || note.type !== "CreateOpenNote") throw new Error("wrong plan");
+    expect(setup.input.token).toBe(BigInt(env.bee));
+    expect(note.input.token).toBe(BigInt(env.ace));
+    expect(setup.input.token).not.toBe(note.input.token);
+  });
+});
