{
  "name": "@afterlight/recovery",
  "version": "0.1.0",
  "description": "Typed Afterlight recovery authorization, relay, and STRK20 action primitives",
  "license": "MIT",
  "type": "module",
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qdeeworld/afterlight.git",
    "directory": "client"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./actions": {
      "types": "./dist/sdk/actions.d.ts",
      "import": "./dist/sdk/actions.js"
    },
    "./encoding": {
      "types": "./dist/sdk/encoding.d.ts",
      "import": "./dist/sdk/encoding.js"
    },
    "./exit-preflight": {
      "types": "./dist/sdk/exit-preflight.d.ts",
      "import": "./dist/sdk/exit-preflight.js"
    },
    "./keys": {
      "types": "./dist/sdk/keys.d.ts",
      "import": "./dist/sdk/keys.js"
    },
    "./messages": {
      "types": "./dist/sdk/messages.d.ts",
      "import": "./dist/sdk/messages.js"
    },
    "./relay": {
      "types": "./dist/sdk/relay.d.ts",
      "import": "./dist/sdk/relay.js"
    },
    "./setup-authorization": {
      "types": "./dist/sdk/setup-authorization.d.mts",
      "import": "./dist/sdk/setup-authorization.mjs"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/sdk/index.js",
    "dist/sdk/index.d.ts",
    "dist/sdk/actions.js",
    "dist/sdk/actions.d.ts",
    "dist/sdk/encoding.js",
    "dist/sdk/encoding.d.ts",
    "dist/sdk/exit-preflight.js",
    "dist/sdk/exit-preflight.d.ts",
    "dist/sdk/keys.js",
    "dist/sdk/keys.d.ts",
    "dist/sdk/messages.js",
    "dist/sdk/messages.d.ts",
    "dist/sdk/relay.js",
    "dist/sdk/relay.d.ts",
    "dist/sdk/setup-authorization.mjs",
    "dist/sdk/setup-authorization.d.mts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:sdk": "node scripts/build-sdk.mjs",
    "prepack": "npm run build:sdk",
    "test:package": "npm run build:sdk && node --test scripts/package.test.mjs",
    "test": "npm run build && npm run tools:check && npm run operator:build && npm run preflight:build && node --test dist/test/*.test.js",
    "tools:check": "tsc -p tsconfig.tools.json",
    "operator:build": "esbuild tools/mainnet-operator.ts --bundle --format=esm --platform=browser --outfile=tools/mainnet-operator.js",
    "preflight:build": "esbuild tools/private-exit-preflight.ts --bundle --format=esm --platform=browser --minify --alias:starknet=./tools/starknet-narrow.ts --metafile=tools/private-exit-preflight.meta.json --outfile=tools/private-exit-preflight.js",
    "verify:locked-artifacts": "node tools/verify-locked-artifacts.mjs",
    "verify:mainnet": "node tools/verify-mainnet.mjs",
    "quote:mainnet": "node tools/quote-declare-deploy.mjs",
    "quote:ready-deploy": "node tools/quote-ready-deployment.mjs",
    "quote:ready-build": "esbuild tools/ready-deployment-data.ts --bundle --format=esm --platform=browser --outfile=tools/ready-quote.js"
  },
  "dependencies": {
    "@starknet-io/types-js": "0.10.4-beta.2",
    "starknet": "10.7.0"
  },
  "devDependencies": {
    "@starknet-io/get-starknet-discovery": "^6.0.4",
    "@starknet-io/get-starknet-wallet-standard": "^6.0.4",
    "@types/node": "24.10.1",
    "esbuild": "^0.28.1",
    "typescript": "5.9.3"
  }
}
